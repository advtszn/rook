{
	"name": "rook",
	"version": "0.1.0",
	"description": "A terminal UI for exploring Redis",
	"module": "src/index.tsx",
	"type": "module",
	"scripts": {
		"dev": "bun run --watch src/index.tsx",
		"build": "bun build --compile src/index.tsx --outfile dist/rook",
		"build:linux-x64": "bun build --compile --target=bun-linux-x64 src/index.tsx --outfile dist/rook-linux-x64",
		"build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 src/index.tsx --outfile dist/rook-darwin-arm64",
		"build:windows-x64": "bun build --compile --target=bun-windows-x64 src/index.tsx --outfile dist/rook-windows-x64.exe"
	},
	"devDependencies": {
		"@types/bun": "latest",
		"@types/react": "^19.2.17"
	},
	"peerDependencies": {
		"typescript": "^5"
	},
	"dependencies": {
		"@opentui/core": "^0.3.2",
		"@opentui/react": "^0.3.2",
		"ioredis": "^5.11.1",
		"react": "^19.2.6"
	}
}
